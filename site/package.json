{
  "name": "cue-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node scripts/preview.mjs",
    "check": "node build.mjs --source-check && node --test test/*.test.mjs",
    "deploy": "npm run check && npm run build && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.151.2"
  }
}
